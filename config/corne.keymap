#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp BACKSLASH   &kp Q  &kp W  &kp E                 &kp R      &kp T        &kp Y    &kp U            &kp I      &kp O    &kp P     &trans
&lt 4 LEFT_WIN  &kp A  &kp S  &kp D                 &kp F      &kp G        &kp H    &kp J            &kp K      &kp L    &kp SEMI  &trans
&lt 3 ESC       &kp Z  &kp X  &kp C                 &kp V      &kp B        &kp N    &kp M            &kp COMMA  &kp DOT  &kp FSLH  &lt 4 SINGLE_QUOTE
                              &mt LEFT_CONTROL DEL  &lt 1 TAB  &kp SPACE    &kp RET  &lt 2 BACKSPACE  &kp MINUS
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans        &kp TILDE       &kp BACKSLASH  &kp UP    &trans     &kp LBRC    &kp RBRC               &kp N7        &kp N8        &kp N9        &kp N0           &trans
&trans        &kp LEFT_SHIFT  &kp LEFT       &kp DOWN  &kp RIGHT  &kp LBKT    &kp RBKT               &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS        &trans
&kp LEFT_ALT  &kp LEFT_WIN    &kp MINUS      &trans    &kp PLUS   &kp LPAR    &kp RIGHT_PARENTHESIS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_MULTIPLY  &kp PLUS
                                             &trans    &trans     &trans      &trans                 &trans        &kp PERIOD
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp EXCLAMATION  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &trans
&trans  &trans           &trans  &trans    &trans    &trans       &trans     &trans     &trans     &trans            &trans             &trans
&trans  &trans           &trans  &trans    &trans    &trans       &kp UNDER  &kp EQUAL  &trans     &trans            &kp SLASH          &kp HOME
                                 &trans    &trans    &trans       &trans     &trans     &trans
            >;
        };

        Fun {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &kp END  &kp F1   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &kp F10  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &kp F20  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &bt BT_CLR    &trans        &trans            &trans          &bt BT_SEL 0    &trans  &trans           &trans             &trans         &trans         &trans
&trans  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &bt BT_SEL 1    &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
&trans  &out OUT_USB  &trans        &trans            &trans          &bt BT_SEL 2    &trans  &trans           &trans             &trans         &trans         &trans
                                    &trans            &trans          &trans          &trans  &trans           &trans
            >;
        };
    };
};
